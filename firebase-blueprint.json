{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Daraz e-commerce product item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "discountPercent": { "type": "integer" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "integer" },
        "stock": { "type": "integer" },
        "imageUrl": { "type": "string" },
        "brand": { "type": "string" },
        "isFreeShipping": { "type": "boolean" },
        "isDarazMall": { "type": "boolean" },
        "isFlashSale": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "price", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order with items, payment, and tracking state",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "orderDate": { "type": "integer" },
        "itemsSummary": { "type": "string" },
        "totalAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "shippingFee": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "trackingStep": { "type": "integer" },
        "recipientName": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "city": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "totalAmount", "paymentMethod", "status", "shippingAddress"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review and rating",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "integer" },
        "comment": { "type": "string" },
        "isVerifiedPurchase": { "type": "boolean" },
        "helpfulCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "userName", "rating", "comment"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public catalog of available products"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders placed by user"
    },
    "/products/{productId}/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Reviews for a specific product"
    }
  }
}
